# Único seletor do ambiente Docker: development ou production.
COMPOSE_PROFILES=development
# NODE_ENV é controlado pelo runtime no container; usado também no desenvolvimento sem Docker.
NODE_ENV=development
APP_URL=http://localhost:3000
APP_PORT=3000
# Uso sem Docker; no Compose esta política deriva de COMPOSE_PROFILES.
ALLOW_LOCAL_HTTP=true
# Obrigatória em production: connection string do servidor PostgreSQL externo.
# Em development via Compose, a conexão ao serviço db é montada automaticamente.
# Para bun run dev fora do Docker, configure localhost:55432 manualmente.
DATABASE_URL=
POSTGRES_USER=pinda
POSTGRES_PASSWORD=
POSTGRES_DB=pinda_dados
# Gere um segredo aleatório com pelo menos 32 caracteres. Nunca use um segredo público.
BETTER_AUTH_SECRET=

# Infoconv SOAP — manter desabilitado até configurar certificado e convênio.
INFOCONV_ENABLED=false
# Somente SOAP está implementado. REST será habilitado após homologação do contrato.
INFOCONV_TRANSPORT=soap
# auto detecta .pfx/.p12; use pem ou pfx para selecionar explicitamente.
INFOCONV_CERTIFICATE_FORMAT=auto
INFOCONV_CERTIFICATE_PATH=/run/secrets/infoconv.pem
INFOCONV_CERTIFICATE_PASSPHRASE=
INFOCONV_REQUESTER_CPF=
INFOCONV_CPF_WSDL=https://acesso.infoconv.receita.fazenda.gov.br/ws/cpf/consultarcpf.asmx?wsdl
INFOCONV_CNPJ_WSDL=https://acesso.infoconv.receita.fazenda.gov.br/ws/cnpj/consultarcnpj.asmx?wsdl
INFOCONV_CA_PATH=/run/secrets/infoconv-ca.pem
# Chaves hexadecimais independentes, cada uma com 32 bytes (64 caracteres).
INFOCONV_CACHE_KEY=
INFOCONV_AUDIT_KEY=
INFOCONV_TIMEOUT_MS=15000
INFOCONV_REQUESTS_PER_MINUTE=30
# Franquia mensal conjunta CPF/CNPJ. Excedente exige liberação administrativa no sistema.
INFOCONV_MONTHLY_LIMIT=10000
INFOCONV_MONTHLY_LIMIT_CPF=
INFOCONV_MONTHLY_LIMIT_CNPJ=
# Caminhos no host usados somente pelo overlay compose.infoconv.yml.
# Nome do arquivo no container usado pelo overlay; para PFX use infoconv.pfx.
INFOCONV_CERTIFICATE_FILENAME=infoconv.pem
INFOCONV_CERTIFICATE_HOST_PATH=
INFOCONV_CA_HOST_PATH=

# Pasta local com infoconv.pem e infoconv-ca.pem, montada somente para leitura.
INFOCONV_CERTIFICATES_DIR=./certificates

# Keycloak OIDC — única forma de login; habilitar após configurar o cliente e seus client roles.
# false mantém a apresentação disponível, mas desabilita o botão Login.
KEYCLOAK_ENABLED=false
# Exceção temporária: HTTP no IdP somente em development com APP_URL HTTP em loopback.
KEYCLOAK_ALLOW_INSECURE_HTTP=false
# URL HTTPS completa do realm, incluindo /realms/NOME_DO_REALM.
KEYCLOAK_ISSUER=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=

# Paralelismo da geração de páginas no build Docker (1 a 32); padrão conservador para VMs.
NEXT_BUILD_CPUS=2
