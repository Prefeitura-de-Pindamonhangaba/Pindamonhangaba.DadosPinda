# Exemplo para Nginx na mesma VM da aplicação.
# Ajuste os caminhos para o certificado e a chave já existentes no servidor.
server {
    listen 80;
    server_name dados.pindamonhangaba.sp.gov.br;
    return 301 https://dados.pindamonhangaba.sp.gov.br$request_uri;
}

server {
    listen 443 ssl;
    server_name dados.pindamonhangaba.sp.gov.br;

    ssl_certificate /etc/pki/tls/certs/pinda-dados-fullchain.pem;
    ssl_certificate_key /etc/pki/tls/private/pinda-dados.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Connection "";
        proxy_cache off;
        proxy_buffering off;
    }
}
